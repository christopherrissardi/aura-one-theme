#!/usr/bin/env python3
"""
Aura Theme Sync Daemon (Rock-Solid Edition)
Automatically synchronizes GNOME Shell Theme, GTK Themes, Accent Colors,
and Libadwaita / GTK4 / GTK3 configs (Nautilus, Settings, etc.) in real time.

Features:
- Full persistence across reboots with zero race conditions.
- Sychronizes all 40 Aura-One variations (OLED, Darker, Dark, Transparent x Accents).
- Robust state-machine that prevents signal ping-pong and false restores.
- Zero CPU usage via native GSettings D-Bus monitors.
"""

import os
import sys
import time
import subprocess
import gi

gi.require_version('Gio', '2.0')
from gi.repository import Gio, GLib

ACCENT_MAP = {
    "blue": "blue",
    "purple": "purple",
    "green": "green",
    "orange": "orange",
    "red": "red",
    "teal": "teal",
    "yellow": "yellow",
    "pink": "pink",
    "slate": "slate",
}

class ThemeSyncDaemon:
    def __init__(self):
        self.settings_shell = Gio.Settings.new('org.gnome.shell.extensions.user-theme')
        self.settings_interface = Gio.Settings.new('org.gnome.desktop.interface')
        
        self.is_internal_update = False
        self.last_applied_theme = None

        # Connect signals
        self.settings_shell.connect('changed::name', self.on_shell_theme_changed)
        self.settings_interface.connect('changed::gtk-theme', self.on_gtk_theme_changed)
        self.settings_interface.connect('changed::accent-color', self.on_accent_changed)

        print("[AuraSync] Daemon iniciado com persistência total para reinicialização.")
        # Perform initial synchronization on startup
        self.sync_current_state()

    def is_aura_theme(self, theme_str):
        if not theme_str:
            return False
        clean = theme_str.strip("'").strip()
        return clean.startswith("Aura-One")

    def restore_default_system_theme(self):
        """Restores stock GNOME appearance by removing custom GTK CSS overrides."""
        print("[AuraSync] Restaurando aparência padrão nativa do GNOME...")
        for conf_dir in ["~/.config/gtk-4.0", "~/.config/gtk-3.0"]:
            target_css = os.path.expanduser(f"{conf_dir}/gtk.css")
            if os.path.exists(target_css) or os.path.islink(target_css):
                try:
                    os.remove(target_css)
                except Exception as e:
                    print(f"[AuraSync] Erro ao remover {target_css}: {e}")

        gtk2_rc = os.path.expanduser("~/.gtkrc-2.0")
        if os.path.exists(gtk2_rc):
            try:
                os.remove(gtk2_rc)
            except Exception:
                pass

        self.last_applied_theme = "Adwaita"

    def apply_aura_theme(self, theme_id):
        clean_theme_id = theme_id.strip("'").strip()
        theme_path = os.path.expanduser(f"~/.local/share/themes/{clean_theme_id}")
        source_css = os.path.join(theme_path, "gtk-4.0", "gtk.css")

        if not os.path.exists(source_css):
            print(f"[AuraSync] Aviso: Pasta do tema '{clean_theme_id}' não encontrada em {theme_path}")
            return

        with open(source_css, "r") as f:
            css_content = f.read()

        # Update gtk-4.0 and gtk-3.0 configs directly
        for conf_dir in ["~/.config/gtk-4.0", "~/.config/gtk-3.0"]:
            full_dir = os.path.expanduser(conf_dir)
            os.makedirs(full_dir, exist_ok=True)
            target_css = os.path.join(full_dir, "gtk.css")
            try:
                if os.path.islink(target_css):
                    os.remove(target_css)
                with open(target_css, "w") as f:
                    f.write(css_content)
                    f.flush()
                    os.fsync(f.fileno())
                os.utime(target_css, None)
            except Exception as e:
                print(f"[AuraSync] Erro ao gravar {target_css}: {e}")

        # Update GTK 2 (Legacy Apps)
        gtk2_rc = os.path.expanduser("~/.gtkrc-2.0")
        theme_gtkrc = os.path.join(theme_path, "gtk-2.0", "gtkrc")
        if os.path.exists(theme_gtkrc):
            try:
                with open(gtk2_rc, "w") as f:
                    f.write(f'include "{theme_gtkrc}"\n')
            except Exception:
                pass

        self.last_applied_theme = clean_theme_id

        # Sync GSettings under internal guard
        self.is_internal_update = True
        try:
            # Sync GTK theme
            curr_gtk = self.settings_interface.get_string('gtk-theme').strip("'")
            if curr_gtk != clean_theme_id:
                self.settings_interface.set_string('gtk-theme', clean_theme_id)

            # Sync Shell theme
            curr_shell = self.settings_shell.get_string('name').strip("'")
            if curr_shell != clean_theme_id:
                self.settings_shell.set_string('name', clean_theme_id)

            # Sync Accent color if theme name specifies one (e.g. Aura-One-OLED-Purple)
            parts = clean_theme_id.split("-")
            if len(parts) >= 4:
                color_part = parts[-1].lower()
                if color_part in ACCENT_MAP:
                    gnome_accent = ACCENT_MAP[color_part]
                    curr_accent = self.settings_interface.get_string('accent-color').strip("'")
                    if curr_accent != gnome_accent:
                        self.settings_interface.set_string('accent-color', gnome_accent)
        except Exception as e:
            print(f"[AuraSync] Erro sincronizando configurações: {e}")
        finally:
            self.is_internal_update = False

        print(f"[AuraSync] ✓ Tema '{clean_theme_id}' aplicado com sucesso em todo o sistema.")

    def sync_current_state(self):
        shell_theme = self.settings_shell.get_string('name').strip("'").strip()
        gtk_theme = self.settings_interface.get_string('gtk-theme').strip("'").strip()

        print(f"[AuraSync] Inicializando estado: Shell='{shell_theme}', GTK='{gtk_theme}'")

        if self.is_aura_theme(shell_theme):
            self.apply_aura_theme(shell_theme)
        elif self.is_aura_theme(gtk_theme):
            self.apply_aura_theme(gtk_theme)
        else:
            # Check if gtk.css exists; if not, keep stock
            target_css = os.path.expanduser("~/.config/gtk-4.0/gtk.css")
            if not os.path.exists(target_css):
                self.restore_default_system_theme()

    def on_shell_theme_changed(self, settings, key):
        if self.is_internal_update:
            return
        theme_id = settings.get_string(key).strip("'").strip()
        print(f"[AuraSync] Evento: Tema do Shell alterado para '{theme_id}'")

        if self.is_aura_theme(theme_id):
            self.apply_aura_theme(theme_id)
        else:
            gtk_theme = self.settings_interface.get_string('gtk-theme').strip("'").strip()
            if not self.is_aura_theme(gtk_theme):
                self.restore_default_system_theme()

    def on_gtk_theme_changed(self, settings, key):
        if self.is_internal_update:
            return
        theme_id = settings.get_string(key).strip("'").strip()
        print(f"[AuraSync] Evento: Tema GTK alterado para '{theme_id}'")

        if self.is_aura_theme(theme_id):
            self.apply_aura_theme(theme_id)
        else:
            shell_theme = self.settings_shell.get_string('name').strip("'").strip()
            if not self.is_aura_theme(shell_theme):
                self.restore_default_system_theme()

    def on_accent_changed(self, settings, key):
        if self.is_internal_update:
            return
        accent_name = settings.get_string(key).strip("'").strip()
        print(f"[AuraSync] Evento: Cor de destaque alterada para '{accent_name}'")
        shell_theme = self.settings_shell.get_string('name').strip("'").strip()
        if self.is_aura_theme(shell_theme):
            self.apply_aura_theme(shell_theme)

def main():
    daemon = ThemeSyncDaemon()
    loop = GLib.MainLoop()
    try:
        loop.run()
    except (KeyboardInterrupt, SystemExit):
        print("\n[AuraSync] Daemon finalizado.")

if __name__ == '__main__':
    main()
