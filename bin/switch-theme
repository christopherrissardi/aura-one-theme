def apply_global_theme(bg_key, accent_key_or_hex):
    # 1. Resolve Background Config
    if bg_key in BG_PRESETS:
        bg_config = BG_PRESETS[bg_key]
    else:
        matched_bg = None
        for k, v in BG_PRESETS.items():
            if bg_key.lower() == v["id"].lower() or bg_key.lower() == k or bg_key.lower() in v["id"].lower():
                matched_bg = v
                break
        if matched_bg:
            bg_config = matched_bg
        else:
            print(f"\033[1;31mErro: Fundo '{bg_key}' não reconhecido.\033[0m")
            print("Opções de fundo: " + ", ".join(BG_PRESETS.keys()))
            return False

    # 2. Resolve Accent Config
    custom_accent = None
    accent_key_lower = accent_key_or_hex.lower()
    if accent_key_lower in ACCENT_PRESETS:
        accent_config = ACCENT_PRESETS[accent_key_lower]
        gnome_accent = accent_config["gnome"]
    elif accent_key_or_hex.startswith("#"):
        custom_accent = {
            "name": f"Custom ({accent_key_or_hex})",
            "hex": accent_key_or_hex,
            "fg_hex": accent_key_or_hex,
        }
        gnome_accent = "blue"
    else:
        accent_config = ACCENT_PRESETS.get(accent_key_lower, ACCENT_PRESETS["blue"])
        gnome_accent = accent_config["gnome"]

    theme_id = bg_config["id"]

    print(f"\n\033[1;35m═══════════════════════════════════════════════════════════════════════\033[0m")
    print(f"\033[1;37m   🚀 APLICANDO TEMA AURA ONE GLOBALMENTE EM TODO O SISTEMA\033[0m")
    print(f"\033[1;35m═══════════════════════════════════════════════════════════════════════\033[0m")
    print(f"  \033[1;33mFundo:\033[0m   {ansi_block(bg_config['window_bg'])} \033[1;37m{bg_config['name']}\033[0m ({bg_config['window_bg']})")
    accent_display = custom_accent['hex'] if custom_accent else ACCENT_PRESETS[gnome_accent]['name']
    print(f"  \033[1;33mDestaque:\033[0m {ansi_block(custom_accent['hex'] if custom_accent else ACCENT_PRESETS[gnome_accent]['hex'])} \033[1;37m{accent_display}\033[0m\n")

    # A. GNOME Shell User Theme
    try:
        subprocess.run(["gsettings", "set", "org.gnome.shell.extensions.user-theme", "name", theme_id], check=True)
        print(f"  \033[1;32m✓\033[0m GNOME Shell Theme: \033[36m{theme_id}\033[0m (Painel, Dock, Modais, Notificações)")
    except Exception as e:
        print(f"  \033[1;31m✗\033[0m Falha ao definir Shell Theme: {e}")

    # B. GNOME GTK Theme (Legacy Apps - Keep Default Adwaita)
    try:
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", "Adwaita"], check=True)
        print(f"  \033[1;32m✓\033[0m GNOME GTK Theme (Legados): \033[36mAdwaita\033[0m (Padrão mantido)")
    except Exception as e:
        print(f"  \033[1;31m✗\033[0m Falha ao definir GTK Theme: {e}")

    # C. GNOME Native Accent Color
    try:
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "accent-color", gnome_accent], check=True)
        print(f"  \033[1;32m✓\033[0m GNOME Accent Color: \033[36m{gnome_accent}\033[0m")
    except Exception as e:
        print(f"  \033[1;31m✗\033[0m Falha ao definir Accent Color: {e}")

    # D. Libadwaita / GTK4 Recolor (Written only to ~/.config/gtk-4.0/gtk.css)
    gtk_css_content = generate_gtk_css(bg_config, custom_accent)
    conf_dir = os.path.expanduser("~/.config/gtk-4.0")
    os.makedirs(conf_dir, exist_ok=True)
    target_css = os.path.join(conf_dir, "gtk.css")
    try:
        if os.path.islink(target_css):
            os.remove(target_css)
        with open(target_css, "w") as f:
            f.write(gtk_css_content)
            f.flush()
            os.fsync(f.fileno())
        os.utime(target_css, None)
        print(f"  \033[1;32m✓\033[0m Libadwaita Recolor: \033[34m~/.config/gtk-4.0/gtk.css\033[0m (Nautilus, Configurações, Apps GTK4)")
    except Exception as e:
        print(f"  \033[1;31m✗\033[0m Falha ao gravar ~/.config/gtk-4.0/gtk.css: {e}")

    # Clean up ~/.config/gtk-3.0/gtk.css so GTK 3 legacy apps don't get corrupted
    gtk3_css = os.path.expanduser("~/.config/gtk-3.0/gtk.css")
    if os.path.exists(gtk3_css) or os.path.islink(gtk3_css):
        try:
            os.remove(gtk3_css)
        except Exception:
            pass

    # E. GTK 2
    gtk2_rc = os.path.expanduser("~/.gtkrc-2.0")
    theme_gtkrc = os.path.expanduser(f"~/.local/share/themes/{theme_id}/gtk-2.0/gtkrc")
    if os.path.exists(theme_gtkrc):
        try:
            with open(gtk2_rc, "w") as f:
                f.write(f'include "{theme_gtkrc}"\n')
            print(f"  \033[1;32m✓\033[0m GTK 2 Theme:       \033[34m~/.gtkrc-2.0\033[0m (Apps Legados)")
        except Exception:
            pass

    print(f"\n\033[1;32m✓ Concluído! O ambiente agora está sincronizado e com visual consistente.\033[0m")
    print(f"\033[1;35m═══════════════════════════════════════════════════════════════════════\033[0m\n")
    return True

def print_help():
    curr_shell, curr_accent = get_current_settings()
    print("\n\033[1;35m═════════════════════════════════════════════════════════════════════════════════════\033[0m")
    print("\033[1;37m   🎨 GERENCIADOR GLOBAL DE TEMAS E CORES - AURA ONE SUITE\033[0m")
    print("\033[1;35m═════════════════════════════════════════════════════════════════════════════════════\033[0m")
    print(f"  \033[1;33mEstado Atual:\033[0m Shell=\033[1;32m{curr_shell}\033[0m | Destaque=\033[1;32m{curr_accent}\033[0m\n")

    print("\033[1;36m  1. OPÇÕES DE FUNDO (BACKGROUND):\033[0m")
    for key, val in BG_PRESETS.items():
        bg_bl = ansi_block(val["window_bg"])
        print(f"     • \033[1;37m{key:<12}\033[0m {bg_bl} {val['name']:<28} \033[90m({val['desc']})\033[0m")

    print("\n\033[1;36m  2. OPÇÕES DE DESTAQUE (ACCENT COLOR):\033[0m")
    for key, val in ACCENT_PRESETS.items():
        ac_bl = ansi_block(val["hex"])
        print(f"     • \033[1;37m{key:<10}\033[0m {ac_bl} {val['name']:<22} \033[90m({val['hex']})\033[0m")
    print("     • \033[1;37m#HEX      \033[0m Ou informe qualquer cor HEX customizada (ex: #ff007f)")

    print("\n\033[1;33m  EXEMPLOS DE USO VIA TERMINAL:\033[0m")
    print("     \033[32mswitch-theme oled purple\033[0m         # Fundo OLED Black + Destaque Roxo")
    print("     \033[32mswitch-theme darker green\033[0m        # Fundo Midnight Darker + Destaque Verde")
    print("     \033[32mswitch-theme transparent amber\033[0m   # Fundo Transparente Glass + Destaque Âmbar")
    print("     \033[32mswitch-theme oled #ff007f\033[0m        # Fundo OLED Black + Destaque Hex Rosa Neon")
    print("     \033[32mswitch-theme original blue\033[0m       # Fundo One Dark Original + Azul Padrão")
    print("     \033[32mswitch-theme                     # Abre o Menu Interativo\033[0m")
    print("\033[1;35m═════════════════════════════════════════════════════════════════════════════════════\033[0m\n")

def interactive_menu():
    print_help()
    try:
        print("\033[1;33mPASSO 1/2: Escolha o Estilo de Fundo\033[0m")
        print("  [1] oled        (Aura One OLED - Pure Black)")
        print("  [2] darker      (Aura One Darker - Midnight)")
        print("  [3] original    (Aura One Dark - Original)")
        print("  [4] transparent (Aura One Transparent - Glass)")
        bg_choice = input("\033[1;37mSelecione o fundo [1-4 ou nome]:\033[0m ").strip().lower()
        if not bg_choice or bg_choice in ['q', 'exit', 'quit']:
            return

        bg_map = {"1": "oled", "2": "darker", "3": "original", "4": "transparent"}
        bg_selected = bg_map.get(bg_choice, bg_choice)

        print("\n\033[1;33mPASSO 2/2: Escolha a Cor de Destaque (Accent)\033[0m")
        acc_keys = list(ACCENT_PRESETS.keys())
        for i, k in enumerate(acc_keys):
            acc_info = ACCENT_PRESETS[k]
            print(f"  [{i+1:>2}] {k:<8} {ansi_block(acc_info['hex'])} {acc_info['name']}")
        print("  [10] Custom HEX (digite ex: #ff007f)")
        
        acc_choice = input("\033[1;37mSelecione a cor [1-10 ou nome/hex]:\033[0m ").strip().lower()
        if not acc_choice or acc_choice in ['q', 'exit', 'quit']:
            return

        if acc_choice.isdigit() and 1 <= int(acc_choice) <= len(acc_keys):
            acc_selected = acc_keys[int(acc_choice) - 1]
        else:
            acc_selected = acc_choice

        apply_global_theme(bg_selected, acc_selected)

    except (KeyboardInterrupt, EOFError):
        print("\nOperação cancelada.")

def main():
    if len(sys.argv) == 1:
        interactive_menu()
    elif len(sys.argv) == 2:
        arg = sys.argv[1].lower().strip()
        if arg in ["-h", "--help", "help", "list", "-l"]:
            print_help()
        elif arg in BG_PRESETS:
            _, curr_accent = get_current_settings()
            apply_global_theme(arg, curr_accent)
        elif arg in ACCENT_PRESETS or arg.startswith("#"):
            curr_shell, _ = get_current_settings()
            bg_key = "oled"
            for k, v in BG_PRESETS.items():
                if v["id"].lower() in curr_shell.lower():
                    bg_key = k
                    break
            apply_global_theme(bg_key, arg)
        else:
            print_help()
    elif len(sys.argv) >= 3:
        bg_arg = sys.argv[1].strip()
        accent_arg = sys.argv[2].strip()
        apply_global_theme(bg_arg, accent_arg)

if __name__ == "__main__":
    main()
