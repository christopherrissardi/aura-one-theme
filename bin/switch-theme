def hex_to_rgb(hex_str):
    hex_str = hex_str.lstrip('#')
    if len(hex_str) == 3:
        hex_str = ''.join([c*2 for c in hex_str])
    if len(hex_str) >= 6:
        return tuple(int(hex_str[i:i+2], 16) for i in (0, 2, 4))
    return (100, 100, 100)

def ansi_block(hex_str, text="   "):
    if hex_str.startswith('rgba'):
        return "\033[48;2;30;30;40m[░]\033[0m"
    try:
        r, g, b = hex_to_rgb(hex_str)
        return f"\033[48;2;{r};{g};{b}m{text}\033[0m"
    except Exception:
        return f"[{hex_str}]"

def get_current_settings():
    try:
        shell_theme = subprocess.check_output(
            ["gsettings", "get", "org.gnome.shell.extensions.user-theme", "name"],
            text=True
        ).strip().strip("'")
    except Exception:
        shell_theme = "Aura-One-OLED"

    try:
        accent = subprocess.check_output(
            ["gsettings", "get", "org.gnome.desktop.interface", "accent-color"],
            text=True
        ).strip().strip("'")
    except Exception:
        accent = "blue"

    return shell_theme, accent

def generate_gtk_css(bg_config, custom_accent=None):
    accent_override = ""
